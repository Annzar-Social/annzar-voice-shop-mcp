# MCP API key — any requests to /mcp without this token are rejected with 401.
# Generate a strong random string (e.g. openssl rand -hex 32).
MCP_API_KEY=your-secret-api-key-here

# Shop adapter: "mock" (default) uses realistic demo data.
# Set to "annzar" to wire up the real Annzar platform (stub — throws not-implemented).
SHOP_ADAPTER=mock

# HTTP port (default 3000)
PORT=3000
