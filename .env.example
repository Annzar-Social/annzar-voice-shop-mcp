# Required: Bearer token for /mcp requests. Generate with: openssl rand -hex 32
MCP_API_KEY=your-secret-api-key-here

# Shop adapter: "mock" (demo data) or "annzar" (stub — throws not-implemented)
SHOP_ADAPTER=mock

# HTTP port (default 3000; Render sets PORT automatically)
PORT=3000

# Public origin used for absolute mock checkout links
PUBLIC_BASE_URL=https://annzar-voice-shop-mcp.onrender.com

# Path for JSON memory file. Render free tier has ephemeral disk; use /tmp
MEMORY_PATH=./data/memory.json
